# ==============================================
# Pharmacy ERP - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/pharmacy_db?sslmode=require"

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=production

# JWT Authentication Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_strong_random_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_strong_random_refresh_secret_here_min_32_chars
